# --- local data / indexes ---
# Project corpora and vector indexes are large and environment-specific.
# Source documents live wherever ingest.yaml points; indexes are rebuildable.
projects/*/data/**
# Credential hashes. Never commit.
projects/*/users.yaml
!projects/*/data/.gitkeep
*.lance/
.lancedb/
storage/

# --- os / editor ---
.DS_Store
.idea/
.vscode/
*.swp
users.yaml

# --- ingest fetch cache (rebuildable) ---
projects/*/.cache/
