# Copy to .env and fill in. .env is gitignored; never commit real values.
# In production these come from your host's secret manager, not a file.

# ── Which project this process serves ───────────────────────────────────────
# Must match a directory name under projects/. One API container per project.
PROJECT=_template

# ── Anthropic (drives the agent loop) ───────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Hugging Face ────────────────────────────────────────────────────────────
# Only needed for gated/private models or the hosted Inference API.
# Local sentence-transformers embeddings work without a token.
HF_TOKEN=
# Cache dir for downloaded model weights. Mount this as a volume in Docker so
# the ~500MB embedding model isn't re-downloaded on every container start.
HF_HOME=./.cache/huggingface

# ── Vector store ────────────────────────────────────────────────────────────
# lancedb = embedded, file-based, zero setup (good for dev + small corpora)
# pgvector = Postgres extension (good for prod, shared across replicas)
VECTOR_BACKEND=lancedb
LANCEDB_PATH=./storage/lancedb
DATABASE_URL=postgresql+asyncpg://mcp:mcp@localhost:5432/mcp

# ── MCP server ──────────────────────────────────────────────────────────────
# stdio  = launched as a subprocess (local dev, Claude Desktop/Code)
# http   = separate service over streamable HTTP (deployed)
MCP_TRANSPORT=http
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ── API service ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the chat API from a browser.
CORS_ORIGINS=http://localhost:5173

# ── Web ─────────────────────────────────────────────────────────────────────
# Baked in at build time by Vite. Must be reachable from the *browser*.
VITE_API_BASE_URL=http://localhost:8000

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
